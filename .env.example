# Copia questo file in ".env" e personalizzalo. Non pubblicare mai il file .env.

HTTP_PORT=8080
APP_TITLE=Rubrica

# Dominio Active Directory (DNS) usato per il login LDAP
LDAP_DOMAIN=example.local
# Opzionale: uno o più server separati da virgola (default ldap://<LDAP_DOMAIN>)
LDAP_SERVER=
# Opzionale: base di ricerca (default DC=example,DC=local)
LDAP_BASE_DN=
LDAP_START_TLS=false
LDAP_TLS_VERIFY=false

# Account di servizio in sola lettura (UPN, DOMINIO\utente o DN)
LDAP_BIND_USER=svc-rubrica@example.local
LDAP_BIND_PASSWORD=

# Gruppo AD che può modificare la rubrica (nome, DN completo o SID).
# "Administrators" è il gruppo builtin; S-1-5-32-544 è il suo SID indipendente dalla lingua.
ADMIN_GROUP=Administrators
# Gruppo opzionale richiesto anche per la sola lettura (vuoto = tutti gli utenti autenticati)
READ_GROUP=

# SSO con la sessione di Windows: richiede ./krb5/krb5.keytab (vedi README)
SSO_ENABLED=true
KRB5_REALM=

# Chiave per firmare i cookie di sessione (vuoto = generata automaticamente)
SECRET_KEY=
SESSION_HOURS=10
